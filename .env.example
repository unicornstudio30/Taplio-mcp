# Your Taplio API key (Taplio → Settings → API). Required.
# Passed to the API as: Authorization: Bearer <key>
TAPLIO_API_KEY=

# Base URL for the Taplio REST API. Optional; defaults to the value below.
TAPLIO_BASE_URL=https://api.taplio.com

# When "true", the server refuses all write/destructive operations
# (create/update/delete drafts, publish, schedule, media upload/attach).
# Read tools (list/get/analytics/inspirations) still work. Optional; default false.
TAPLIO_READONLY=false

# Per-request timeout in milliseconds. Optional; default 30000.
TAPLIO_TIMEOUT_MS=30000

# ----- Remote HTTP server (Vercel) only -----
# Required for the HTTP/remote server. Clients must present this token in the
# request URL (?token=...) or an Authorization: Bearer header. Generate a strong
# random value: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_SHARED_SECRET=

# Local HTTP server port (npm run http). Optional; default 3000.
PORT=3000
