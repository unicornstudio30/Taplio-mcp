{
  "name": "taplio-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the official Taplio REST API",
  "license": "MIT",
  "type": "module",
  "bin": {
    "taplio-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "mcp": "tsx src/index.ts",
    "http": "tsx src/httpLocal.ts",
    "http:prod": "node dist/httpLocal.js",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vercel/node": "^5.8.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
